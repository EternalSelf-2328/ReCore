#!/usr/bin/env bash
# Sets ReCore's version in Cargo.toml and Cargo.lock, as the nightly release
# does before building: `scripts/set-version 0.2.0-nightly.20261020.5`.
# The app, the packages' names and SOURCE.txt's release link all take it. A
# stable version also goes into the Arch PKGBUILD, the metainfo's releases,
# dated today, and the landing page's last-known release:
# `scripts/set-version 0.2.0` before committing and tagging v0.2.0. The README
# names no version, so nothing else needs changing.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
version=${1:?usage: scripts/set-version VERSION}
# Cargo takes only SemVer; a prerelease's numeric parts can't start with 0.
number='(0|[1-9][0-9]*)' part='(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)'
if ! [[ $version =~ ^$number\.$number\.$number(-$part(\.$part)*)?$ ]]; then
  echo "scripts/set-version: $version isn't a SemVer version" >&2
  exit 2
fi
# The package's version is the manifest's first; the lockfile's follows its
# name. Python keeps this portable: BSD sed's -i takes a backup suffix and
# reads the file name as its script on macOS, which broke the macOS job.
python3 - "$version" <<'PY'
import re
import sys
from pathlib import Path

version = sys.argv[1]
manifest = Path("Cargo.toml")
text = manifest.read_text(encoding="utf-8")
text, count = re.subn(r'(?m)^version = "[^"]+"', f'version = "{version}"', text, count=1)
if count != 1:
    raise SystemExit("scripts/set-version: Cargo.toml has no package version")
manifest.write_text(text, encoding="utf-8")

lock = Path("Cargo.lock")
text = lock.read_text(encoding="utf-8")
text, count = re.subn(
    r'(?m)(name = "recore"\nversion = ")[^"]+"',
    rf'\g<1>{version}"',
    text,
    count=1,
)
if count != 1:
    raise SystemExit("scripts/set-version: Cargo.lock has no recore package")
lock.write_text(text, encoding="utf-8")

# A pkgver can't hold a prerelease's "-", and nightlies don't build from a tag.
if "-" not in version:
    pkgbuild = Path("packaging/arch/PKGBUILD")
    text = pkgbuild.read_text(encoding="utf-8")
    text, pkgver = re.subn(r'(?m)^pkgver=.*$', f"pkgver={version}", text, count=1)
    text, pkgrel = re.subn(r'(?m)^pkgrel=.*$', "pkgrel=1", text, count=1)
    if (pkgver, pkgrel) != (1, 1):
        raise SystemExit("scripts/set-version: packaging/arch/PKGBUILD has no pkgver/pkgrel")
    pkgbuild.write_text(text, encoding="utf-8")
PY
if [[ $version != *-* ]]; then
  metainfo=packaging/linux/io.github.leriart.ReCore.metainfo.xml
  python3 - "$metainfo" "$version" <<'PY'
import datetime
import sys
from pathlib import Path

path = Path(sys.argv[1])
version = sys.argv[2]
text = path.read_text(encoding="utf-8")
if f'<release version="{version}"' not in text:
    text = text.replace(
        "  <releases>\n",
        f'  <releases>\n    <release version="{version}" date="{datetime.date.today().isoformat()}"/>\n',
        1,
    )
    path.write_text(text, encoding="utf-8")
PY
  # The landing page shows its last-known stable release before GitHub
  # answers, and keeps it when the API is offline. Keep that fallback in
  # step with the version the packages carry.
  python3 - "$version" <<'PY'
import datetime
import re
import sys
from pathlib import Path

version = sys.argv[1]
path = Path("site/home.js")
if not path.is_file():
    raise SystemExit("scripts/set-version: site/home.js is missing")
text = path.read_text(encoding="utf-8")
base = f"https://github.com/leriart/ReCore/releases/download/v{version}"
page = f"https://github.com/leriart/ReCore/releases/tag/v{version}"
assets = [
    (f"ReCore-{version}-windows-x64.zip", f"{base}/ReCore-{version}-windows-x64.zip"),
    (f"ReCore-{version}-x86_64.AppImage", f"{base}/ReCore-{version}-x86_64.AppImage"),
    (f"recore-{version}-1-x86_64.pkg.tar.zst", f"{base}/recore-{version}-1-x86_64.pkg.tar.zst"),
    (f"ReCore-{version}-macos-arm64.dmg", f"{base}/ReCore-{version}-macos-arm64.dmg"),
    (f"ReCore-{version}-macos-arm64.zip", f"{base}/ReCore-{version}-macos-arm64.zip"),
    (f"ReCore-{version}-macos-x64.dmg", f"{base}/ReCore-{version}-macos-x64.dmg"),
    (f"ReCore-{version}-macos-x64.zip", f"{base}/ReCore-{version}-macos-x64.zip"),
    (f"ReCore-{version}-source.zip", f"{base}/ReCore-{version}-source.zip"),
    ("SHA256SUMS.txt", f"{base}/SHA256SUMS.txt"),
]
lines = [
    "    const FALLBACK_RELEASE = {",
    f'        tag_name: "v{version}",',
    f'        name: "ReCore {version}",',
    f'        html_url: "{page}",',
    f'        published_at: "{datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}",',
    "        assets: [",
]
for index, (name, url) in enumerate(assets):
    lines.extend(
        [
            "            {",
            f'                name: "{name}",',
            f'                browser_download_url: "{url}"',
            "            }" + ("," if index + 1 < len(assets) else ""),
        ]
    )
lines.extend(["        ]", "    };"])
replacement = "\n".join(lines)
text, count = re.subn(r"    const FALLBACK_RELEASE = \{.*?\n    \};", replacement, text, flags=re.S)
if not count:
    raise SystemExit("scripts/set-version: site/home.js has no FALLBACK_RELEASE block")
path.write_text(text, encoding="utf-8")
index = Path("site/index.html")
if index.is_file():
    page_text = index.read_text(encoding="utf-8")
    page_text = re.sub(
        r'(<span class="top-version" id="top-version">V)[^<]+',
        rf"\g<1>{version}",
        page_text,
        count=1,
    )
    # The scripts carry the release in their cache key, so a visitor who
    # already loaded one release's translations gets the next one.
    page_text = re.sub(
        r'(src="(?:i18n|home|demo)\.js\?v=)[^"]+"',
        rf'\g<1>{version}"',
        page_text,
    )
    index.write_text(page_text, encoding="utf-8")
    preview = Path("site/preview.html")
    if preview.is_file():
        preview_text = preview.read_text(encoding="utf-8")
        preview_text = re.sub(
            r'(src="(?:i18n|demo)\.js\?v=)[^"]+"',
            rf'\g<1>{version}"',
            preview_text,
        )
        preview.write_text(preview_text, encoding="utf-8")
PY
fi
