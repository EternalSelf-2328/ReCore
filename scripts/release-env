# Sourced before building a binary people download: `source scripts/release-env
# TARGET`, then plain `cargo build --target TARGET`. Rust embeds source paths for panic messages, and C's __FILE__ ends
# up in error messages too; they'd name the folders of the machine that built
# it, its owner's home folder among them. These flags name none.
# CARGO_ENCODED_RUSTFLAGS replaces .cargo/config.toml's rustflags, so a
# target's own come along here.
recore_release_target=${1:?usage: source scripts/release-env TARGET}
recore_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# Widest first: rustc and Clang take the last mapping that matches.
recore_maps=("$HOME=/home" "${CARGO_HOME:-$HOME/.cargo}=/cargo" "$recore_root=/recore")
recore_rust=()
recore_c=()
for map in "${recore_maps[@]}"; do
  recore_rust+=("--remap-path-prefix=$map")
  recore_c+=("-ffile-prefix-map=$map")
done
case "$recore_release_target" in
  x86_64-pc-windows-msvc)
    # Match LiveKit's Windows runtime linkage, as .cargo/config.toml does.
    recore_rust=(-Ctarget-feature=+crt-static "${recore_rust[@]}")
    # cargo-xwin compiles C with clang-cl, which takes Clang's flags this way.
    recore_c=("${recore_c[@]/#//clang:}") ;;
  x86_64-unknown-linux-gnu | aarch64-apple-darwin | x86_64-apple-darwin) ;;
  *) echo "scripts/release-env: no flags known for $recore_release_target" >&2; return 2 ;;
esac
CARGO_ENCODED_RUSTFLAGS=$(IFS=$'\x1f'; printf '%s' "${recore_rust[*]}")
export CARGO_ENCODED_RUSTFLAGS
# The cc crate reads only the first of CFLAGS_<target> and its fallbacks, and
# `cargo xwin build` sets that one, so take its environment, which adds to
# these rustflags, and add the C flags to what it sets.
recore_target_flags=${recore_release_target//-/_}
if [[ "$recore_release_target" == *-windows-msvc ]]; then
  eval "$(cargo xwin env --target "$recore_release_target")"
  # thorvg-sys tells bindgen's libclang `--target=x86_64-none-elf` on every
  # cross build, which can't read the MSVC headers. bindgen adds these
  # arguments after a build script's, and Clang takes the last target.
  recore_bindgen="BINDGEN_EXTRA_CLANG_ARGS_$recore_target_flags"
  export "$recore_bindgen=${!recore_bindgen:-} --target=$recore_release_target"
fi
recore_cflags="CFLAGS_$recore_target_flags" recore_cxxflags="CXXFLAGS_$recore_target_flags"
export "$recore_cflags=${!recore_cflags:-} ${recore_c[*]}"
export "$recore_cxxflags=${!recore_cxxflags:-} ${recore_c[*]}"
unset recore_release_target recore_root recore_maps recore_rust recore_c map \
  recore_target_flags recore_cflags recore_cxxflags recore_bindgen
